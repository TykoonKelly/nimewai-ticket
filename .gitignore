# ============================================
# NIMEWAI TICKET APP - .gitignore
# ============================================

# ============================================
# DEPENDENCIES
# ============================================
node_modules/
.pnp/
.pnp.js
.pnpm/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml
backend/package-lock.json

# ============================================
# BUILD OUTPUT
# ============================================
dist/
build/
out/
.next/
/.output/
*.tsbuildinfo

# ============================================
# ENVIRONMENT VARIABLES
# ============================================
# Frontend environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Backend environment files
backend/.env
backend/.env.local
backend/.env.*.local

# Firebase service account (CRITICAL - NEVER commit this!)
# This file contains your Firebase Admin SDK private key
backend/firebase-service-account.json
*.firebase-service-account.json
firebase-service-account.json

# ============================================
# FIREBASE
# ============================================
firebase-debug.log
.firebase/
.firebase.json
.firebaserc
*.firebase.json

# ============================================
# LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/
backend/*.log

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.orig
*.rej

# ============================================
# EDITOR FILES
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.~lock.*
*.sublime-*
*.iml
.project
.classpath
.settings/
.vscode/settings.json
.vscode/launch.json

